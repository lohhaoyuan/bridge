{
  "name": "bridge-elo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "DEV_LOGIN=1 node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "express": "^5.1.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
